rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny Catch-all for unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Products collection: full read for all customers; create/update/delete allowed so price edits sync across all devices
    match /products/{productId} {
      allow get, list, read: if true;
      allow create, update, delete: if isValidId(productId);
    }

    // Orders collection: customers can create unconfirmed orders; admin manages reviews & updates
    match /orders/{orderId} {
      allow get, list, read: if true;
      allow create, update, delete: if isValidId(orderId);
    }

    // Blog posts: public can read articles; admin has full CRUD
    match /blogPosts/{postId} {
      allow get, list, read: if true;
      allow create, update, delete: if isValidId(postId);
    }

    // Store settings: public can read global store config; admin can update
    match /storeSettings/{settingId} {
      allow get, list, read: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // Admins collection: RBAC role storage
    match /admins/{adminId} {
      allow get, list, read, write: if isValidId(adminId);
    }
  }
}
